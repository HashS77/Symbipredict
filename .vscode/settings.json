{
    "python-envs.defaultEnvManager": "ms-python.python:system",
    "files.exclude": {
        "**/__pycache__": true,
        "**/venv": true,
        "**/.venv": true,
        "**/.venv-*": true
    },
    "files.watcherExclude": {
        "**/venv/**": true,
        "**/.venv/**": true,
        "**/.venv-*/**": true,
        "**/backend/dataset/**": true
    },
    "search.exclude": {
        "**/venv": true,
        "**/.venv": true,
        "**/.venv-*": true,
        "**/backend/dataset/**": true
    },
    "python.analysis.exclude": [
        "**/venv/**",
        "**/.venv/**",
        "**/.venv-*/**",
        "**/backend/legacy/**",
        "**/backend/dataset/**"
    ]
}